		Thiết kế bởi crowflux
		'''
	RoninPants:
		'''
		'Luôn nhắc nhở bạn rằng có nhiều con đường lên đỉnh núi.'
		Thiết kế bởi crowflux
		'''
	// RainbowCursor: Causes your mouse cursor to have shifting rainbow colors
	BoneWhip:
		'''
		7 sát thương triệu hồi theo thẻ
		{$CommonItemTooltip.Whips}
		Hiệu quả hơn với nhiều mục tiêu so với hầu hết các roi khác
		'Đây là số 11'
		'''
	// Princess64: "{$PaintingArtist.Lazure}"
	// PaintingOfALass: "{$PaintingArtist.Lazure}"
	// DarkSideHallow: "{$PaintingArtist.Lazure}"
	GlommerPetItem:
		'''
		Triệu hồi Glommer
		'Cánh hoa lấp lánh dưới ánh sáng'
		'''
	BerniePetItem:
		'''
		Triệu hồi gấu bông thân thương
		'Bạn thời thơ ấu của tôi - Bernie!'
		'''
	DeerclopsPetItem:
		'''
		Triệu hồi Hươu Độc Nhãn tí hon
		'Bạn nhìn tôi à? BẠN nhìn tôi à?'
		'''
	PigPetItem:
		'''
		Triệu hồi Người Heo nhỏ
		'Kinh quá. Đầy lông luôn.'
		'''
	ChesterPetItem:
		'''
		Triệu hồi rương sống để chứa đồ cho bạn
		'Nó đang nhìn vào tâm hồn tôi.'
		'''
	MonsterLasagna:
		'''
		{$CommonItemTooltip.MediumStats}
		'Có vị như lông và thịt với mì sợi.'
		'''
	FroggleBunwich:
		'''
		{$CommonItemTooltip.MediumStats}
		'Có chút vị cay nồng.'
		'''
	TentacleSpike:
		'''
		Găm gai gây sát thương vào kẻ địch
		'Đừng bao giờ cầm đầu nhọn.'
		'''
	// LucyTheAxe: "'I love Lucy!'"
	HamBat:
		'''
		Càng ăn no càng mạnh
		Đánh bại kẻ địch sẽ tạm thời tăng hồi máu
		'VŨ KHÍ MÔNG HEO ĐÓ!'
		'''
	BatBat:
		'''
		Có thể hồi máu cho người dùng khi đánh trúng
		'Có lẽ tôi có thể dùng gậy này để đánh dơi.'
		'''
	// GarlandHat: "'It smells like prettiness.'"
	BoneHelm:
		'''
		Triệu hồi bàn tay bóng tối tấn công kẻ thù
		'Chỉ nhìn thôi cũng thấy nhức đầu rồi.'
		'''
	// Eyebrella: "'Don't get rain in your eye!'"
	Magiluminescence:
		'''
		Tăng tốc độ di chuyển và tăng tốc
		Phát sáng khi đeo
		'Một tia sáng ngắn ngủi trong cuộc đời tăm tối.'
		'''
