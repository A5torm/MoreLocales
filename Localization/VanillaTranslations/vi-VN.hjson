Workshop: {
	HubDescriptionDefault: Chọn một tùy chọn để biết thêm thông tin.
	HubWorlds: Nhập Thế giới
	HubDescriptionImportWorlds: Nhập các Thế giới bạn đã đăng ký từ Steam Workshop vào danh sách Thế giới của bạn để khám phá.
	HubPublishWorlds: Xuất bản Thế giới
	HubDescriptionPublishWorlds: Xuất bản Thế giới của bạn lên Steam Workshop để người khác cùng thưởng thức.
	HubResourcePacks: Sử dụng Gói tài nguyên
	HubDescriptionUseResourcePacks: Sử dụng các Gói tài nguyên bạn đã tải về hoặc đăng ký từ Steam Workshop để tận hưởng nghệ thuật & bản địa hóa của chúng.
	HubPublishResourcePacks: Xuất bản Gói tài nguyên
	HubDescriptionPublishResourcePacks: Xuất bản Gói tài nguyên của bạn lên Steam Workshop để người khác cùng sử dụng.
	Publish: Xuất bản
	WorldName: Tên:
	ResourcePackName: Tên:
	WorldPublishDescription: Xuất bản một thế giới sẽ tải nó lên Steam Workshop ở chế độ riêng tư - mặc định chỉ bạn thấy. Bạn có thể chỉnh ảnh xem trước, tiêu đề và mô tả trên trang Steam, và đặt công khai khi sẵn sàng. Khi gửi thế giới này, bạn đồng ý với điều khoản dịch vụ của Workshop.
	ResourcePackPublishDescription: Xuất bản gói tài nguyên sẽ tải nó lên Steam Workshop ở chế độ riêng tư - mặc định chỉ bạn thấy. Bạn có thể chỉnh ảnh xem trước, tiêu đề và mô tả trên trang Steam, và đặt công khai khi sẵn sàng. Khi gửi gói tài nguyên này, bạn đồng ý với điều khoản dịch vụ của Workshop.
	SettingsPublicityPublic: Công khai
	SettingsPublicityFriendsOnly: Chỉ bạn bè
	SettingsPublicityPrivate: Riêng tư
	SettingsPublicityDescriptionSharedNote: Bạn có thể điều chỉnh cài đặt hiển thị qua trang workshop bất cứ lúc nào
	SettingsPublicityPublicDescription: 
	'''
	Nội dung của bạn sẽ hiển thị & khả dụng cho mọi người ngay khi xuất bản
	{$Workshop.SettingsPublicityDescriptionSharedNote}
	'''
	SettingsPublicityFriendsOnlyDescription: 
	'''
	Nội dung của bạn chỉ hiển thị & sử dụng được bởi bạn và bạn bè sau khi xuất bản
	{$Workshop.SettingsPublicityDescriptionSharedNote}
	'''
	SettingsPublicityPrivateDescription: 
	'''
	Nội dung của bạn chỉ hiển thị cho bạn sau khi xuất bản
	{$Workshop.SettingsPublicityDescriptionSharedNote}
	'''
	CategoryTitleDisclaimer: Thỏa thuận dịch vụ
	CategoryTitleTags: Thẻ
	CategoryTitlePublicity: Hiển thị
	SteamDisclaimer: Khi gửi mục này, bạn đồng ý với điều khoản dịch vụ Workshop.
	PreviewImagePathTitle: Ảnh:
	PreviewImagePathEmpty: Trống
	PreviewImagePathDescription: 
	'''
	Chọn ảnh xem trước cho mục này,
	ảnh này sẽ hiển thị khi duyệt workshop (kích thước tối đa 512x512)
	'''
	EnterNewNameForImportedWorld: Nhập tên Thế giới:
	InfoDescriptionDefault: Vui lòng chọn cách xuất bản mục của bạn với các tùy chọn trên
	SteamDisclaimerDescrpition: 
	'''
	Mở trang điều khoản dịch vụ Steam đầy đủ
	Vui lòng tải nội dung một cách có trách nhiệm
	'''
	ReportIssue_CouldNotCreateTemporaryFolder: Không thể tạo thư mục tạm thời!
	ReportIssue_CannotPublishZips: Không thể xuất bản Gói tài nguyên dạng zip lên workshop!
	ReportIssue_FailedToLoadSubscribedFile: Không thể tải tệp đã đăng ký! đường dẫn: {FilePath}! lý do: {Reason}
	ReportIssue_CouldNotCreateResourcePackManifestFile: Không thể tạo manifest cho gói tài nguyên! lý do: {Reason}
	ReportIssue_FailedToPublish_Common: Không thể xuất bản mục lên steam!
	ReportIssue_FailedToPublish_WithoutKnownReason: "{$Workshop.ReportIssue_FailedToPublish_Common} Mã lỗi: {Reason}"
	ReportIssue_FailedToPublish_AccessDeniedBecauseUserDoesntOwnLicenseForApp: "{$Workshop.ReportIssue_FailedToPublish_Common} Nếu lỗi lặp lại, hãy thử khởi động lại steam!"
	ReportIssue_FailedToPublish_InvalidParametersForPublishing: "{$Workshop.ReportIssue_FailedToPublish_Common} Bạn có chỉnh sửa ID ứng dụng steam của game không?"
	ReportIssue_FailedToPublish_CouldNotFindFolderToUpload: "{$Workshop.ReportIssue_FailedToPublish_Common} Không tìm thấy thư mục nội dung cho mục xuất bản?!"
	ReportIssue_FailedToPublish_SteamFileLockFailed: "{$Workshop.ReportIssue_FailedToPublish_Common} Không thể lấy khóa UGC. Nếu lỗi lặp lại, hãy thử khởi động lại steam!"
	ReportIssue_FailedToPublish_LimitExceeded: "{$Workshop.ReportIssue_FailedToPublish_Common} Vượt quá giới hạn dung lượng! Hãy đảm bảo ảnh xem trước dưới 1mb và bạn còn dung lượng trên steam cloud"
	ReportIssue_FailedToPublish_UserDidNotAcceptWorkshopTermsOfService: "{$Workshop.ReportIssue_FailedToPublish_Common} Bạn cần chấp nhận điều khoản dịch vụ của Workshop!"
	ReportIssue_FailedToPublish_ImageSizeIsTooLarge: 
	'''
	Ảnh bạn chọn phải có kích thước 512x512 pixel hoặc nhỏ hơn!
	Kích thước hiện tại: {Width}x{Height}.
	'''
	ReportLogsButton: Nhật ký
	ReportLogsInitialMessage: Hiện chưa có gì để hiển thị.
}

WorkshopTags: {
	AdventureWorlds: Phiêu lưu
	AdventureWorldsDescription: Thế giới thủ công nơi bạn phiêu lưu với luật lệ rõ ràng!
	GolfWorlds: Golf
	GolfWorldsDescription: Sân golf Terraria tự làm, nơi bạn có thể lập kỷ lục mới.
	AllItemsWorlds: Tất cả vật phẩm
	AllItemsWorldsDescription: Thế giới có thể tìm thấy mọi vật phẩm trong rương.
	StarterWorlds: Khởi đầu
	StarterWorldsDescription: Thế giới giúp bạn khởi đầu thuận lợi.
	JourneyWorlds: Hành trình
	JourneyWorldsDescription: Thế giới yêu cầu nhân vật Chế độ Hành trình – quyền năng lớn & trách nhiệm lớn!
	ClassicWorlds: Cổ điển
	ClassicWorldsDescription: Thế giới dựa trên trải nghiệm Terraria tiêu chuẩn.
	ExpertWorlds: Chuyên gia
	ExpertWorldsDescription: Thế giới dựa trên độ khó chuyên gia - vận may và vinh quang, nhóc!
	MasterWorlds: Bậc thầy
	MasterWorldsDescription: Thế giới dựa trên độ khó Bậc thầy, chỉ dành cho người thích thử thách!
	ChallengeWorlds: Thử thách
	ChallengeWorldsDescription: Thế giới thử thách kỹ năng của bạn! Từ Parkour đến Giải đố và nhiều hơn nữa!
	CorruptionWorlds: Tha Hóa
	CorruptionWorldsDescription: Thế giới bị lây nhiễm bởi Tha Hóa.
	CrimsonWorlds: Đỏ Máu
	CrimsonWorldsDescription: Thế giới bị Đỏ Máu nuốt chửng.
	SmallWorlds: Nhỏ
	SmallWorldsDescription: Thế giới nhỏ, gọn và thoải mái!
	MediumWorlds: Trung bình
	MediumWorldsDescription: Thế giới không quá nhỏ cũng không quá lớn, vừa đủ!
	LargeWorlds: Lớn
	LargeWorldsDescription: Thế giới đủ lớn cho cả nhóm!
	OtherWorlds: Khác
	OtherWorldsDescription: Thế giới phục vụ mục đích khác, đừng nhầm với Otherworlds!
	FromTerrariaMods: Từ Mod
	FromTerrariaModsDescription: Gói tài nguyên với nội dung dựa trên mod.
	PopularCulture: Văn hóa đại chúng
	PopularCultureDescription: Gói tài nguyên đầy yếu tố văn hóa đại chúng.
	FunSilly: Vui nhộn/Hài hước
	FunSillyDescription: Gói tài nguyên vui nhộn, hài hước. Meme của bạn ở đây!
	Music: Nhạc
	MusicDescription: Gói tài nguyên thay đổi nhạc Terraria, mang lại cảm giác mới!
	LanguageTranslations: Dịch ngôn ngữ
	LanguageTranslationsDescription: Gói tài nguyên điều chỉnh bản dịch, hoặc thêm bản dịch hoàn toàn mới!
	HighResolution: Độ phân giải cao
	HighResolutionDescription: Gói tài nguyên tập trung vào nội dung độ phân giải cao.
	Overhaul: Đại tu
	OverhaulDescription: Gói tài nguyên đại tu hoàn toàn một phần hoặc toàn bộ Terraria!
	Tweaks: Tinh chỉnh
	TweaksDescription: Gói tài nguyên chỉ thay đổi nhỏ một số thứ nhất định.
	OtherResourcePacks: Khác
	OtherResourcePacksDescription: Gói tài nguyên phục vụ mục đích khác, thật khác biệt!
}

