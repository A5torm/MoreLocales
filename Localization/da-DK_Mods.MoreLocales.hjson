Configs: {
	Headers: {
		Fonts: Skrifttype-indstillinger
		// Features: Other Features
	}

	ClientSideConfig: {
		DisplayName: Indstillinger Til Klient-siden

		ForcedFont: {
			Label: Påtving Skrifttype
			Tooltip:
				'''
				Tvinger spillet til at bruge den valgte lokaliserings-skrifttype, fuldkommen uafhængigt af de nuværende sprogindstillinger.
				Den er sat til {$Configs.LocalizedFont.None.Label} som standard, hvilket betyder, at skrifttypen automatisk ændres baseret på sproget.
				'''
		}

		LocalizedPrefixPlacement: {
			// Label: Smart Prefix Position
			// Tooltip: Changes the position of an item's prefix in certain languages
		}

		LocalizedPrefixGenderPluralization: {
			// Label: Smart Prefix Inflection
			// Tooltip: Changes the inflection of an item's prefix depending on the item in certain languages
		}
	}

	LocalizedFont: {
		Tooltip: Skrifttypen, som spillet bruger. Småændringer til skrifttypen for de forskellige sprog er nødvendige på grund af Unicode-restriktioner
		None.Label: Ingen
		Default.Label: Almindelig
		Japanese.Label: Japansk
		Korean.Label: Koreansk
	}
}

