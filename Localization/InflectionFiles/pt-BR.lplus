[Inflections]
Word: !de, !do, !para, !con, !em

MascSg: -o,  -e,  -ã,  -m,  X,     -ão,   -ão,  -ão,  -l,  -or,   -n,   -r,   -s,   -z,   X,       -asma
FemSg:  -a,  X,   X,   X,   -ção,  -ona,  -ãa,  X,    X,   -ora,  X,    X,    X,    X,    -triz,   X
MascPl: -os, -es, -ãs, -ns, X,     -ões,  -ãos, -ães, -is, -ores, -nes, -res, -ses, -zes, X,       -asmas
FemPl:  -as, X,   X,   X,   -ções, -onas, -ãas, X,    X,   -oras, X,    X,    X,    X,    -trizes, X

<Exceptions>
MascSg: guarda\-chuva, dia
FemSg: mão, flor, chave

[Items]

# Acronyms are impossible to regularize using this system, so they need to be done separately.

<PDA>
Gender: Masc

# Unadapted nicknames are a similar situation.

<Uzi>
Gender: Fem

[Prefixes]

# This is a common change for all vanilla languages;
# 'Light' the adjective was unanimously translated as either the noun, or a transliteration, in other languages.

<Light:(Leve)>