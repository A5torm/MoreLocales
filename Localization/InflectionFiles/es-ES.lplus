[Inflections]
Word: !de, !del, !para, !con, !en

MascSg: -o,  -e,  -An,   X,      -ul,   -l,   -or,   X,     -az,   -er,   -asma
FemSg:  -a,  X,   -Nna,  -ión,   -ula,  X,    -ora,  -iz,   X,     X,     X
MascPl: -os, -es, -Nnes, X,      -ules, -les, -ores, X,     -aces, -eres, -asmas
FemPl:  -as, X,   -Nnas, -iones, -ulas, X,    -oras, -ices, X,     X,     X

<Exceptions>
MascSg: paraguas, día
FemSg: flor, mano, llave, sangre

[Items]

# Compound nouns are generally masculine, i. e. 'El latespinas', 'El lanzahojas'.

<ThornWhip>
Inflection: MascSg

<LeafBlower>
Inflection: MascSg

# Acronyms are impossible to regularize using this system, so they need to be done separately.

<PDA>
Gender: Masc

<SDMG>
Gender: Fem

# Unadapted nicknames are a similar situation.

<Uzi>
Gender: Fem

[Prefixes]

# This is a common change for all vanilla languages;
# 'Light' the adjective was unanimously translated as either the noun, or a transliteration, in other languages.

<Light:(Ligero)>