Configs: {
	Headers: {
		Fonts: 字體設定
		// Features: Other Features
	}

	ClientSideConfig: {
		DisplayName: 客戶端設定

		ForcedFont: {
			Label: 強制使用在地化字體類型
			Tooltip:
				'''
				強制遊戲使用此類型的在地化字體，忽略目前的語言設置。
				預設為{$Configs.LocalizedFont.None.Label}，代表字體會根據所選語言動態變更。
				'''
		}

		LocalizedPrefixPlacement: {
			// Label: Smart Prefix Position
			// Tooltip: Changes the position of an item's prefix in certain languages
		}

		LocalizedPrefixGenderPluralization: {
			// Label: Smart Prefix Inflection
			// Tooltip: Changes the inflection of an item's prefix depending on the item in certain languages
		}
	}

	LocalizedFont: {
		Tooltip:
			'''
			遊戲使用的字體類型。
			由於 Unicode 的限制，針對不同語言的字體需要進行微調。
			'''
		None.Label: 無
		Default.Label: 預設
		Japanese.Label: 日文
		Korean.Label: 韓文
	}
}

